# Copy this file to .env on the production host, then replace every
# CHANGE_ME value. Never commit the populated .env file.
APP_NAME="AutoMind AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://automind.rafeequae.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
API_VERSION=1.0.0
ALLOW_DEMO_SEEDING=false
SOCIAL_LOGIN_ENABLED=true
PUSH_NOTIFICATIONS_ENABLED=true
ANDROID_APPLICATION_ID=com.automind.ai
ADMIN_WEB_USERNAME=admin
ADMIN_WEB_PASSWORD_HASH=CHANGE_ME

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=CHANGE_ME
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
# Safe defaults for a single-server/shared-hosting deployment. Switch these
# three values to redis only after configuring a reachable Redis service.
CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PRIVATE_FILESYSTEM_DISK=local
SIGNED_URL_TTL_MINUTES=10

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS=noreply@automind.rafeequae.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

OPENAI_API_KEY=CHANGE_ME
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DIAGNOSIS_MODEL=gpt-5.6-terra
OPENAI_VISION_MODEL=gpt-5.6-terra
OPENAI_AUDIO_MODEL=gpt-audio-1.5
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_PRICE_SEARCH_MODEL=gpt-5.6-luna
OPENAI_REQUEST_TIMEOUT_SECONDS=120
OPENAI_MAX_OUTPUT_TOKENS=5000
OPENAI_BACKGROUND_MODE=false
OPENAI_WEBHOOK_SECRET=CHANGE_ME
OPENAI_STORE_RESPONSES=false
OPENAI_VISION_DETAIL=high
OPENAI_DAILY_USER_BUDGET_USD=2.00
OPENAI_DAILY_GLOBAL_BUDGET_USD=100.00
OPENAI_PRICING_VERSION=openai-api-standard-2026-07-23
# Standard-tier USD rates per 1M tokens, plus USD per web-search call.
# Re-verify against the official pricing page before a later production release.
OPENAI_PRICING_MODELS_JSON='{"gpt-5.6-terra":{"input":"2.5","cachedInput":"0.25","output":"15"},"gpt-audio-1.5":{"input":"32","output":"10"},"gpt-4o-mini-transcribe":{"input":"1.25","output":"5"},"gpt-5.6-luna":{"input":"1","cachedInput":"0.1","output":"6","webSearchCall":"0.01"}}'
OPENAI_MODEL_CAPABILITIES_JSON={}
RUN_OPENAI_LIVE_TESTS=false

GOOGLE_CLIENT_IDS=CHANGE_ME
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
APPLE_CLIENT_IDS=CHANGE_ME
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys

FCM_PROJECT_ID=CHANGE_ME
FCM_CREDENTIALS_PATH=
FCM_CREDENTIALS_BASE64=CHANGE_ME
FCM_ANDROID_CHANNEL_ID=automind_high_importance
FCM_TIMEOUT_SECONDS=15
FCM_VALIDATE_ONLY=false
FCM_STALE_TOKEN_DAYS=90
GEOCODING_ENDPOINT=
GEOCODING_API_KEY=

DIAGNOSIS_MAX_IMAGE_BYTES=10485760
DIAGNOSIS_MAX_AUDIO_BYTES=15728640
DIAGNOSIS_MAX_IMAGE_DIMENSION=6000
PROVIDER_IMAGE_MAX_DIMENSION=2048
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
CLAMAV_COMMAND=
PRICE_SEARCH_TTL_DAYS=7
PRICE_SOURCE_MAX_AGE_DAYS=30

RAW_MEDIA_RETENTION_DAYS=30
AI_METADATA_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
DELETED_ACCOUNT_GRACE_DAYS=30

ADMIN_CORS_ORIGINS=https://automind.rafeequae.com
