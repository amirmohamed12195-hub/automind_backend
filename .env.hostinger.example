# Hostinger shared-hosting configuration for automind-ai.net.
# Copy to .env, keep it outside Git, and set a newly generated OpenAI API key.
APP_NAME="AutoMind AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://automind-ai.net
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
API_VERSION=1.0.0
ALLOW_DEMO_SEEDING=false
SOCIAL_LOGIN_ENABLED=true
PUSH_NOTIFICATIONS_ENABLED=true
ANDROID_APPLICATION_ID=com.automind.ai
ANDROID_APP_LINK_SHA256_CERT_FINGERPRINTS=REPLACE_WITH_PLAY_APP_SIGNING_SHA256
APPLE_TEAM_ID=REPLACE_WITH_APPLE_TEAM_ID
LEGAL_OPERATOR_NAME=AutoMind
LEGAL_EFFECTIVE_DATE=2026-08-11
MINIMUM_USER_AGE=16
SUPPORT_EMAIL=support@automind-ai.net
PRIVACY_EMAIL=privacy@automind-ai.net
APP_STORE_URL=
PLAY_STORE_URL=
ADMIN_WEB_USERNAME=admin
ADMIN_WEB_PASSWORD_HASH=REPLACE_WITH_A_BCRYPT_PASSWORD_HASH
ADMIN_DEMO_SECTIONS_ENABLED=false

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=REPLACE_WITH_HOSTINGER_DB_HOST
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_HOSTINGER_DB_NAME
DB_USERNAME=REPLACE_WITH_HOSTINGER_DB_USERNAME
DB_PASSWORD=REPLACE_WITH_A_NEW_DATABASE_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

CACHE_STORE=file
QUEUE_CONNECTION=database
QUEUE_STALE_AFTER_SECONDS=90
DIAGNOSTIC_REDISPATCH_AFTER_SECONDS=90
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PRIVATE_FILESYSTEM_DISK=local
SIGNED_URL_TTL_MINUTES=10

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=REPLACE_WITH_HOSTINGER_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM_ADDRESS=noreply@automind-ai.net
MAIL_FROM_NAME="${APP_NAME}"

OPENAI_API_KEY=REPLACE_WITH_A_NEW_OPENAI_API_KEY
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DIAGNOSIS_MODEL=gpt-5.6-terra
OPENAI_VISION_MODEL=gpt-5.6-terra
OPENAI_AUDIO_MODEL=gpt-audio-1.5
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_PRICE_SEARCH_MODEL=gpt-5.6-luna
OPENAI_DIAGNOSIS_REASONING_EFFORT=low
OPENAI_VISION_REASONING_EFFORT=low
OPENAI_PRICE_SEARCH_REASONING_EFFORT=low
OPENAI_REQUEST_TIMEOUT_SECONDS=120
OPENAI_MAX_OUTPUT_TOKENS=5000
OPENAI_BACKGROUND_MODE=false
OPENAI_WEBHOOK_SECRET=

# Keep disabled until the store sandbox checklist is complete.
BILLING_ENABLED=false
BILLING_ENVIRONMENT=sandbox
BILLING_WEBHOOK_BASE_URL=https://automind-ai.net/api/v1/webhooks
BILLING_TERMS_URL=https://automind-ai.net/terms
BILLING_PRIVACY_URL=https://automind-ai.net/privacy
ACCOUNT_OBFUSCATION_SECRET=REPLACE_WITH_A_STABLE_RANDOM_32_PLUS_CHARACTER_SECRET
BILLING_RECONCILIATION_BATCH_SIZE=100
BILLING_RECONCILIATION_STALE_HOURS=12
BILLING_STALE_RESERVATION_HOURS=2

APPLE_BUNDLE_ID=com.automind.ai
APPLE_APP_ID=REPLACE_WITH_NUMERIC_APP_ID
APPLE_ISSUER_ID=REPLACE_WITH_APP_STORE_CONNECT_ISSUER_ID
APPLE_KEY_ID=REPLACE_WITH_IAP_KEY_ID
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_PATH=REPLACE_WITH_ABSOLUTE_IAP_P8_PATH
APPLE_ROOT_CERTIFICATES_PATH=REPLACE_WITH_ABSOLUTE_APPLE_ROOTS_PATH
APPLE_ONLINE_CERTIFICATE_CHECKS=true
APPLE_OPENSSL_BINARY=openssl

GOOGLE_PLAY_PACKAGE_NAME=com.automind.ai
GOOGLE_PLAY_PROJECT_ID=automind-d7a2b
GOOGLE_PLAY_SERVICE_ACCOUNT=
GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=REPLACE_WITH_ABSOLUTE_GOOGLE_PLAY_SERVICE_ACCOUNT_PATH
GOOGLE_PLAY_PUBSUB_AUDIENCE=https://automind-ai.net/api/v1/webhooks/google/play-notifications
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT_EMAIL=REPLACE_WITH_PUBSUB_PUSH_SERVICE_ACCOUNT_EMAIL
GOOGLE_PLAY_PUBSUB_TOPIC=REPLACE_WITH_PUBSUB_TOPIC
OPENAI_STORE_RESPONSES=false
OPENAI_VISION_DETAIL=high
OPENAI_DAILY_USER_BUDGET_USD=2.00
OPENAI_DAILY_GLOBAL_BUDGET_USD=100.00
OPENAI_PRICING_VERSION=openai-api-standard-2026-08-08
OPENAI_PRICING_MODELS_JSON='{"gpt-5.6-terra":{"input":"2","cachedInput":"0.2","output":"12"},"gpt-audio-1.5":{"input":"32","output":"10"},"gpt-4o-mini-transcribe":{"input":"1.25","output":"5"},"gpt-5.6-luna":{"input":"0.2","cachedInput":"0.02","output":"1.2","webSearchCall":"0.01"}}'
OPENAI_MODEL_CAPABILITIES_JSON={}
RUN_OPENAI_LIVE_TESTS=false

GOOGLE_CLIENT_IDS=REPLACE_WITH_GOOGLE_SERVER_CLIENT_ID
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
APPLE_CLIENT_IDS=com.automind.ai,REPLACE_WITH_APPLE_SERVICE_ID
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys

FCM_PROJECT_ID=automind-d7a2b
FCM_CREDENTIALS_PATH=REPLACE_WITH_ABSOLUTE_FIREBASE_SERVICE_ACCOUNT_PATH
FCM_CREDENTIALS_BASE64=
FCM_ANDROID_CHANNEL_ID=automind_high_importance
FCM_TIMEOUT_SECONDS=15
FCM_VALIDATE_ONLY=false
FCM_STALE_TOKEN_DAYS=90
GEOCODING_ENDPOINT=
GEOCODING_API_KEY=

DIAGNOSIS_MAX_IMAGE_BYTES=10485760
DIAGNOSIS_MAX_AUDIO_BYTES=15728640
DIAGNOSIS_MAX_IMAGE_DIMENSION=6000
PROVIDER_IMAGE_MAX_DIMENSION=2048
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
CLAMAV_COMMAND=
PRICE_SEARCH_TTL_DAYS=7
PRICE_SOURCE_MAX_AGE_DAYS=30

RAW_MEDIA_RETENTION_DAYS=30
AI_METADATA_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
DELETED_ACCOUNT_GRACE_DAYS=30

ADMIN_CORS_ORIGINS=https://automind-ai.net
