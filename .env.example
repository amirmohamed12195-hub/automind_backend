APP_NAME="AutoMind AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
API_VERSION=1.0.0
ALLOW_DEMO_SEEDING=false
SOCIAL_LOGIN_ENABLED=false
PUSH_NOTIFICATIONS_ENABLED=false
ANDROID_APPLICATION_ID=com.automind.ai
ADMIN_WEB_USERNAME=admin
ADMIN_WEB_PASSWORD_HASH=

APP_MAINTENANCE_DRIVER=cache
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=automind
DB_USERNAME=automind
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
CACHE_STORE=redis
QUEUE_CONNECTION=redis
QUEUE_STALE_AFTER_SECONDS=90
DIAGNOSTIC_REDISPATCH_AFTER_SECONDS=90
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PRIVATE_FILESYSTEM_DISK=local
SIGNED_URL_TTL_MINUTES=10

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="noreply@automind.example"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DIAGNOSIS_MODEL=gpt-5.6-terra
OPENAI_VISION_MODEL=gpt-5.6-terra
OPENAI_AUDIO_MODEL=gpt-audio-1.5
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_PRICE_SEARCH_MODEL=gpt-5.6-luna
OPENAI_DIAGNOSIS_REASONING_EFFORT=low
OPENAI_VISION_REASONING_EFFORT=low
OPENAI_PRICE_SEARCH_REASONING_EFFORT=low
OPENAI_REQUEST_TIMEOUT_SECONDS=120
OPENAI_MAX_OUTPUT_TOKENS=5000
OPENAI_BACKGROUND_MODE=false
OPENAI_WEBHOOK_SECRET=

# Store billing is fail-closed and disabled until both store environments are configured.
BILLING_ENABLED=false
BILLING_ENVIRONMENT=sandbox
BILLING_WEBHOOK_BASE_URL=https://api.example.com/api/v1/webhooks
BILLING_TERMS_URL=https://api.example.com/terms
BILLING_PRIVACY_URL=https://api.example.com/privacy
ACCOUNT_OBFUSCATION_SECRET=
BILLING_RECONCILIATION_BATCH_SIZE=100
BILLING_RECONCILIATION_STALE_HOURS=12
BILLING_STALE_RESERVATION_HOURS=2

APPLE_BUNDLE_ID=com.automind.ai
APPLE_APP_ID=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_PATH=
APPLE_ROOT_CERTIFICATES_PATH=
APPLE_ONLINE_CERTIFICATE_CHECKS=true

GOOGLE_PLAY_PACKAGE_NAME=com.automind.ai
GOOGLE_PLAY_PROJECT_ID=
GOOGLE_PLAY_SERVICE_ACCOUNT=
GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=
GOOGLE_PLAY_PUBSUB_AUDIENCE=
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_PUBSUB_TOPIC=
OPENAI_STORE_RESPONSES=false
OPENAI_VISION_DETAIL=high
OPENAI_DAILY_USER_BUDGET_USD=2.00
OPENAI_DAILY_GLOBAL_BUDGET_USD=100.00
OPENAI_PRICING_VERSION=unconfigured
# JSON rates are USD per 1M tokens; webSearchCall is USD per call. Refresh from official pricing before production.
OPENAI_PRICING_MODELS_JSON={}
# Override only when a newly verified model is not yet in the safe built-in capability map.
OPENAI_MODEL_CAPABILITIES_JSON={}
# Opt-in only. Runs a paid provider smoke test when explicitly passed to PHPUnit.
RUN_OPENAI_LIVE_TESTS=false

GOOGLE_CLIENT_IDS=
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
APPLE_CLIENT_IDS=
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys

FCM_PROJECT_ID=
# Prefer a mounted secret file in production. Alternatively inject the
# base64-encoded service-account JSON through your secret manager.
FCM_CREDENTIALS_PATH=
FCM_CREDENTIALS_BASE64=
FCM_ANDROID_CHANNEL_ID=automind_high_importance
FCM_TIMEOUT_SECONDS=15
FCM_VALIDATE_ONLY=false
FCM_STALE_TOKEN_DAYS=90
GEOCODING_ENDPOINT=
GEOCODING_API_KEY=

DIAGNOSIS_MAX_IMAGE_BYTES=10485760
DIAGNOSIS_MAX_AUDIO_BYTES=15728640
DIAGNOSIS_MAX_IMAGE_DIMENSION=6000
PROVIDER_IMAGE_MAX_DIMENSION=2048
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
CLAMAV_COMMAND=
PRICE_SEARCH_TTL_DAYS=7
PRICE_SOURCE_MAX_AGE_DAYS=30

RAW_MEDIA_RETENTION_DAYS=30
AI_METADATA_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
DELETED_ACCOUNT_GRACE_DAYS=30

ADMIN_CORS_ORIGINS=https://admin.automind.example
